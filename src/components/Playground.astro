<div class="playground" data-playground>
  <div class="playground-top mono"><span><span class="live-dot"></span> A LITTLE ROOM FOR PLAY</span><span>EXPT. 001</span></div>
  <div class="toy-stage">
    <svg class="toy-svg" viewBox="0 0 600 490" role="img" aria-label="A playful collection of connected ideas: a screen, an orange block, a smiling blue flower, and a green sphere.">
      <defs>
        <pattern id="dot-grid" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#b7b7aa" opacity=".55" /></pattern>
        <radialGradient id="ball-shade" cx="32%" cy="25%" r="76%"><stop stop-color="#e9ffb3" /><stop offset=".5" stop-color="#c5ee6a" /><stop offset="1" stop-color="#7ba72e" /></radialGradient>
        <linearGradient id="block-front" x2="0" y2="1"><stop stop-color="#ff8e57" /><stop offset="1" stop-color="#e76634" /></linearGradient>
        <linearGradient id="blue-shade" x1="0" y1="0" x2=".9" y2="1"><stop stop-color="#4169ff" /><stop offset="1" stop-color="#1743cf" /></linearGradient>
        <filter id="toy-shadow" x="-50%" y="-50%" width="200%" height="210%"><feDropShadow dx="0" dy="17" stdDeviation="12" flood-color="#27251a" flood-opacity=".13" /></filter>
      </defs>
      <rect width="600" height="490" fill="url(#dot-grid)" />
      <ellipse cx="305" cy="391" rx="231" ry="50" fill="#deded2" opacity=".3" />
      <path class="connection-line" d="M160 297Q284 170 420 306T291 151T464 131" fill="none" stroke="#92968a" stroke-width="1.5" stroke-dasharray="5 7" />
      <g class="orbit-sketch" fill="none" stroke="#30312b" stroke-width="1.1"><ellipse cx="300" cy="262" rx="225" ry="119" transform="rotate(-29 300 262)" /><path d="m96 304-5 20 20-4" /></g>
      <g class="toy" data-toy="screen" data-x="160" data-y="297" transform="translate(160 297)" data-label="Screen idea">
        <g class="toy-body" filter="url(#toy-shadow)">
          <path d="m-95-80 164 23 17 127-164-22z" fill="#282b29" /><path d="m-85-70 145 20 13 99-144-19z" fill="#faf9f0" />
          <path d="m-95-80 10-7 164 23-10 7z" fill="#5c6059" /><path d="m69-57 10-7 17 127-10 7z" fill="#111510" />
          <path d="m-12 64 33 5 4 29-34-4z" fill="#484c43" /><path d="m-43 99 71-4 30 13-71 6z" fill="#282b29" />
          <path d="m-51-30-15 11 19 16m75-16 18 16-15 10m-22-48-15 56" fill="none" stroke="#284de7" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" /><circle cx="1" cy="53" r="3" fill="#c5ee6a" />
        </g>
      </g>
      <g class="toy" data-toy="block" data-x="420" data-y="306" transform="translate(420 306)" data-label="Space idea">
        <g class="toy-body" filter="url(#toy-shadow)">
          <path d="m-70-53 78-39 77 42-78 42z" fill="#ffa675" /><path d="m-70-53 77 45v106l-77-45z" fill="url(#block-front)" /><path d="m7-8 78-42v106L7 98z" fill="#ce512b" />
          <path d="m-50-20 38 22v55l-38-22z" fill="none" stroke="#ffbd91" stroke-width="1.5" /><path d="m-46-57 54-27 53 30L7-25z" fill="none" stroke="#ffd0ad" stroke-width="1.5" /><path d="m31 10 34-18v48L31 59z" fill="#ee7448" />
        </g>
      </g>
      <g class="toy" data-toy="flower" data-x="291" data-y="151" transform="translate(291 151)" data-label="Play idea">
        <g class="toy-body" filter="url(#toy-shadow)">
          <path d="M0-100C20-100 28-72 37-69 47-65 73-82 87-66c14 17-5 38-3 49 2 12 29 19 24 42-5 21-35 19-42 27-8 9-1 37-21 47-21 9-36-16-48-17-12 0-30 23-48 12-19-12-9-40-15-49-7-10-36-10-39-32-3-22 25-27 29-38 4-11-11-36 5-50 17-15 41 4 52 1C-18-79-21-100 0-100Z" fill="url(#blue-shade)" />
          <ellipse cx="-1" cy="-2" rx="44" ry="45" fill="#f6f4df" /><ellipse class="toy-eye" cx="-15" cy="-7" rx="4.5" ry="7" fill="#272b24" /><ellipse class="toy-eye" cx="12" cy="-7" rx="4.5" ry="7" fill="#272b24" />
          <path d="M-12 12q10 12 23 0" fill="none" stroke="#272b24" stroke-width="3" stroke-linecap="round" /><path d="M-24-71q-24-5-34 13" fill="none" stroke="#6485ff" stroke-width="2" stroke-linecap="round" />
        </g>
      </g>
      <g class="toy" data-toy="ball" data-x="464" data-y="131" transform="translate(464 131)" data-label="Curiosity idea">
        <g class="toy-body" filter="url(#toy-shadow)"><circle r="49" fill="url(#ball-shade)" /><ellipse cx="-12" cy="-20" rx="15" ry="8" transform="rotate(-35 -12 -20)" fill="#f3ffd0" opacity=".55" /><path d="M-45 11q44 34 90-10" fill="none" stroke="#729c32" stroke-width="1" opacity=".5" /></g>
      </g>
      <g class="tiny-spark" stroke="#2a3029" stroke-width="2" stroke-linecap="round"><path d="M110 110v24m-12-12h24m375 278v18m-9-9h18" /><path d="m506 225 5 5m-5 0 5-5" /></g>
      <g transform="translate(64 177) rotate(-12)"><rect x="-12" y="-17" width="98" height="30" rx="15" fill="#f7f6f0" stroke="#d6d6ca" /><text x="37" y="3" text-anchor="middle" font-family="monospace" font-size="11" fill="#53594a">what if…?</text></g>
    </svg>
    <div class="drag-note" aria-hidden="true" hidden>go on, move things around <span>↗</span></div>
  </div>
  <div class="playground-bottom"><span class="mono" data-play-status aria-live="polite">DESIGN + CODE + A BIT OF CURIOSITY</span><button class="shuffle-button" data-shuffle aria-label="Remix the playground" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m17 3 4 4-4 4M3 7h18M7 21l-4-4 4-4m14 4H3" /></svg><span>Remix</span></button></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-playground]');
  if (root) {
    const svg = root.querySelector<SVGSVGElement>('svg.toy-svg')!;
    svg.setAttribute('role', 'group');
    svg.setAttribute('aria-label', 'Idea playground. Focus a shape and use arrow keys to move it, or drag with a pointer.');
    root.querySelector<HTMLElement>('.drag-note')!.hidden = false;
    root.querySelector<HTMLButtonElement>('[data-shuffle]')!.hidden = false;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const toys = [...root.querySelectorAll<SVGGElement>('[data-toy]')].map((el) => ({
      el,
      x: Number(el.dataset.x),
      y: Number(el.dataset.y),
      angle: 0,
    }));
    type Toy = typeof toys[number];
    const clampX = (x: number) => Math.max(105, Math.min(495, x));
    const clampY = (y: number) => Math.max(110, Math.min(365, y));
    const connections = root.querySelector<SVGPathElement>('.connection-line')!;
    const paint = (toy: Toy) => {
      toy.el.setAttribute('transform', `translate(${toy.x} ${toy.y}) rotate(${toy.angle})`);
      const [screen, block, flower, ball] = toys;
      connections.setAttribute('d', `M${screen.x} ${screen.y}Q${(screen.x + block.x) / 2} ${Math.min(screen.y, block.y) - 120} ${block.x} ${block.y}T${flower.x} ${flower.y}T${ball.x} ${ball.y}`);
    };
    // Work in SVG coordinates so dragging stays accurate at every screen size.
    const point = (event: PointerEvent) => {
      const p = svg.createSVGPoint();
      p.x = event.clientX;
      p.y = event.clientY;
      return p.matrixTransform(svg.getScreenCTM()!.inverse());
    };
    let active: { toy: Toy; dx: number; dy: number; pointerId: number } | null = null;
    // Some mobile browsers ignore touch-action on SVG groups. Cancel native
    // panning only when a gesture starts on a toy; the empty stage still scrolls.
    svg.addEventListener('touchstart', (event) => {
      if ((event.target as Element).closest('[data-toy]')) event.preventDefault();
    }, { passive: false });
    toys.forEach((toy) => {
      toy.el.setAttribute('role', 'button');
      toy.el.setAttribute('tabindex', '0');
      toy.el.setAttribute('aria-label', `${toy.el.dataset.label}. Use arrow keys to move, Enter to turn.`);
      toy.el.addEventListener('pointerdown', (event) => {
        if (event.button !== 0 || active) return;
        event.preventDefault();
        if (event.pointerType !== 'touch') toy.el.focus({ preventScroll: true });
        const p = point(event);
        active = { toy, dx: p.x - toy.x, dy: p.y - toy.y, pointerId: event.pointerId };
        toy.el.setPointerCapture(event.pointerId);
        toy.el.classList.add('is-dragging');
      });
      toy.el.addEventListener('pointermove', (event) => {
        if (!active || active.toy !== toy || active.pointerId !== event.pointerId) return;
        const p = point(event);
        toy.x = clampX(p.x - active.dx);
        toy.y = clampY(p.y - active.dy);
        paint(toy);
      });
      const release = () => {
        if (active?.toy !== toy) return;
        toy.el.classList.remove('is-dragging');
        active = null;
      };
      toy.el.addEventListener('pointerup', release);
      toy.el.addEventListener('pointercancel', release);
      toy.el.addEventListener('lostpointercapture', release);
      toy.el.addEventListener('keydown', (event) => {
        const steps: Record<string, [number, number]> = {
          ArrowLeft: [-16, 0], ArrowRight: [16, 0], ArrowUp: [0, -16], ArrowDown: [0, 16],
        };
        if (steps[event.key]) {
          event.preventDefault();
          toy.x = clampX(toy.x + steps[event.key][0]);
          toy.y = clampY(toy.y + steps[event.key][1]);
        } else if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          toy.angle = (toy.angle + 30) % 360;
        } else return;
        paint(toy);
      });
    });
    let remixes = 0;
    if (!motion.matches) {
      svg.addEventListener('pointermove', (event) => {
        if (motion.matches) return;
        const p = point(event);
        const flower = toys.find((toy) => toy.el.dataset.toy === 'flower')!;
        const dx = Math.max(-3, Math.min(3, (p.x - flower.x) / 70));
        const dy = Math.max(-3, Math.min(3, (p.y - flower.y) / 70));
        root.querySelectorAll('.toy-eye').forEach((eye) => eye.setAttribute('transform', `translate(${dx} ${dy})`));
      });
      svg.addEventListener('pointerleave', () => root.querySelectorAll('.toy-eye').forEach((eye) => eye.removeAttribute('transform')));
    }
    root.querySelector('[data-shuffle]')?.addEventListener('click', () => {
      if (active) return;
      remixes++;
      const arrangements = [
        [[167, 177, -8], [401, 312, 12], [220, 320, -25], [451, 140, 0]],
        [[175, 310, 10], [427, 166, -12], [277, 146, 25], [370, 345, 0]],
        [[160, 297, 0], [420, 306, 0], [291, 151, 0], [464, 131, 0]],
      ];
      const arrangement = arrangements[(remixes - 1) % arrangements.length];
      toys.forEach((toy, i) => {
        if (!motion.matches) toy.el.animate([{ opacity: .45 }, { opacity: 1 }], { duration: 400 });
        [toy.x, toy.y, toy.angle] = arrangement[i];
        paint(toy);
      });
      const messages = [
        'A DIFFERENT ANGLE. A NEW POSSIBILITY.',
        'GOOD THINGS HAPPEN BETWEEN DISCIPLINES.',
        'DESIGN + CODE + A BIT OF CURIOSITY',
      ];
      root.querySelector('[data-play-status]')!.textContent = messages[(remixes - 1) % 3];
    });
  }
</script>

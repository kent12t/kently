---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
---
<Layout title={`${project.title} — Kent / Pixelsmith`} description={project.intro}>
  <Header />
  <main id="main" class="case-study wrap">
    <a class="text-link case-back" href="/#work"><span aria-hidden="true">↖</span> Back to the work</a>
    <p class="eyebrow mono">{project.category} / {project.year}</p>
    <h1>{project.title}<span class="cobalt">.</span></h1><p class="case-subtitle">{project.line}</p>
    <div class="case-facts"><div><span class="mono">CONTEXT</span><p>{project.client}</p></div><div><span class="mono">MY CONTRIBUTION</span><p>{project.role}</p></div></div>
    <ProjectArtwork kind={project.kind} large />
    <div class="case-body"><section><p class="eyebrow mono">THE EXPERIENCE</p><h2>{project.line}</h2><p class="case-lede">{project.intro}</p><p>{project.context}</p></section><section><p class="eyebrow mono">THE THINKING & THE MAKING</p>{project.decisions.map((decision, index) => <div class="case-decision"><span class="mono">0{index + 1}</span><div><h3>{decision.title}</h3><p>{decision.body}</p></div></div>)}</section><section class="case-outcome"><p class="eyebrow mono">WHAT CAME OUT OF IT</p><p>{project.outcome}</p></section><section class="case-credits"><h2>A team effort.</h2><p>{project.credits}</p><p class="mono case-tools">{project.tools}</p></section><aside class="evidence-note"><span class="mono">A NOTE ON THE VISUALS</span><p>{project.evidence}</p></aside></div>
    <a class="next-project" href={`/work/${next.slug}/`}><span class="mono">NEXT EXPLORATION</span><span>{next.title} <span aria-hidden="true">↗</span></span></a>
  </main>
  <footer class="site-footer wrap"><a class="footer-brand" href="/">pixelsmith<span class="cobalt">.</span></a><a class="text-link" href="/#contact">Let’s connect ↗</a></footer>
</Layout>

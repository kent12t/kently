---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Pixelsmith — Kent, designer & creative technologist',
	description = 'Kent brings design, code, and physical spaces together. Explore playful interfaces, interactive exhibitions, and the thinking behind them.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f7f6f0" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>
